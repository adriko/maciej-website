---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "HATO Projekt i Nadzór | Maciej Korzeń - Kierownik Budowy i Inspektor Nadzoru",
  description = "Kompleksowe usługi kierownika budowy, inspektora nadzoru inwestorskiego oraz projekty instalacji i odbiory techniczne. Zadbaj o bezpieczeństwo swojej inwestycji.",
} = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-hato-cream text-gray-800 antialiased selection:bg-hato-sand selection:text-hato-green-dark">
    <slot />
  </body>
</html>