---
// src/components/Contact.astro
---
<section id="kontakt" class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
      <!-- Dane kontaktowe -->
      <div class="lg:col-span-5">
        <span class="text-hato-sand-dark font-semibold text-xs uppercase tracking-widest block mb-3">
          Kontakt & Bezpłatna Wstępna Konsultacja
        </span>
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-hato-green mb-6 leading-tight">
          Porozmawiajmy o Twojej inwestycji.
        </h2>
        <p class="text-gray-600 text-base leading-relaxed mb-8">
          Planujesz rozpoczęcie budowy, szukasz kierownika budowy lub potrzebujesz odbioru technicznego mieszkania? Skontaktuj się bezpośrednio telefonicznie lub zostaw wiadomość.
        </p>

        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-hato-cream border border-hato-sand-light text-hato-green flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-gray-500 font-semibold">Telefon bezpośredni</p>
              <a href="tel:+48600000000" class="font-display text-xl font-bold text-hato-green hover:text-hato-sand-dark transition-colors">
                +48 600 000 000
              </a>
              <p class="text-xs text-gray-400 mt-0.5">Poniedziałek – Sobota: 7:00 – 19:00</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-hato-cream border border-hato-sand-light text-hato-green flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-gray-500 font-semibold">Adres e-mail</p>
              <a href="mailto:kontakt@hatoprojekt.pl" class="font-display text-lg font-bold text-hato-green hover:text-hato-sand-dark transition-colors">
                kontakt@hatoprojekt.pl
              </a>
              <p class="text-xs text-gray-400 mt-0.5">Odpowiedź zazwyczaj w ciągu 24h</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Formularz -->
      <div class="lg:col-span-7">
        <form class="bg-hato-cream p-8 sm:p-10 rounded-2xl border border-gray-200/80 shadow-sm space-y-6">
          <div class="grid sm:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-sm font-semibold text-gray-700 mb-2">Imię i nazwisko</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Jan Kowalski"
                class="w-full px-4 py-3 rounded-lg bg-white border border-gray-300 focus:outline-none focus:border-hato-green focus:ring-1 focus:ring-hato-green transition-colors text-sm"
              />
            </div>
            <div>
              <label for="phone" class="block text-sm font-semibold text-gray-700 mb-2">Numer telefonu</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                placeholder="+48 000 000 000"
                class="w-full px-4 py-3 rounded-lg bg-white border border-gray-300 focus:outline-none focus:border-hato-green focus:ring-1 focus:ring-hato-green transition-colors text-sm"
              />
            </div>
          </div>

          <div>
            <label for="service" class="block text-sm font-semibold text-gray-700 mb-2">Interesująca usługa</label>
            <select
              id="service"
              name="service"
              class="w-full px-4 py-3 rounded-lg bg-white border border-gray-300 focus:outline-none focus:border-hato-green focus:ring-1 focus:ring-hato-green transition-colors text-sm"
            >
              <option value="kierownik">Kierownik Budowy</option>
              <option value="inspektor">Inspektor Nadzoru Inwestorskiego</option>
              <option value="odbior">Odbiór Techniczny Mieszkania / Domu</option>
              <option value="projekt">Projekt Budowlany / Instalacyjny</option>
              <option value="inne">Inne / Konsultacja techniczna</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-gray-700 mb-2">Opis inwestycji / Treść wiadomości</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              placeholder="Napisz kilka słów o lokalizacji, etapie budowy lub terminie planowanych prac..."
              class="w-full px-4 py-3 rounded-lg bg-white border border-gray-300 focus:outline-none focus:border-hato-green focus:ring-1 focus:ring-hato-green transition-colors text-sm"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-4 px-8 bg-hato-green text-white font-bold rounded-lg hover:bg-hato-green-light transition-colors shadow-md text-base"
          >
            Wyślij zapytanie
          </button>
          <p class="text-xs text-gray-500 text-center">
            Dbam o Twoją prywatność. Przesłane dane służą wyłącznie do kontaktu w sprawie zapytania.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>